{
	"name": "devcontainer",
	"image": "ghcr.io/ivanklee86/devcontainer/rust:1",

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Set *default* container specific settings.json values on container create.
			"settings": {
				// Format with rustfmt (through rust-analyzer) on save.
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer",
					"editor.formatOnSave": true
				},
				// Show clippy lints, not just `cargo check` errors.
				"rust-analyzer.check.command": "clippy",
				// Check every target (tests, benches, examples), not just the lib/bin.
				"rust-analyzer.check.allTargets": true,
				// Use target/rust-analyzer so rust-analyzer and `cargo build` don't block each other on the target lock.
				"rust-analyzer.cargo.targetDir": true,
				"remote.sshAgentForwarding": true,
				"yaml.schemas": {
					"https://taskfile.dev/schema.json": [
						"**/Taskfile.yml",
						"**/Taskfile.yaml",
						"tasks/**"
					]
				}
			},

			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"anthropic.claude-code",
				"fill-labs.dependi",
				"github.vscode-github-actions",
				"GitHub.copilot",
				"ms-azuretools.vscode-docker",
				"redhat.vscode-yaml",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"task.vscode-task",
				"vadimcn.vscode-lldb"
			]
		}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": {
		"install-prek": "prek install && prek run"
	},

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false
		}
	},

	"mounts": [
		// Mount the .gitconfig into the container to preserve git settings like email and username.
		"source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
		// Mount the host ~/.claude directory to share Claude Code settings, memory, and history.
		// The host directory must exist, and it hides the image's baked ~/.claude/settings.json.
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
		// Mount known_hosts read-only to avoid TOFU prompts that block non-interactive git operations.
		// Contains only public host key fingerprints — no secrets. Private keys use the forwarded agent.
		"source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,consistency=cached,readonly",
		// Mount the host gh config so gh, and git through the host .gitconfig's `gh auth git-credential`
		// helper, use the host's GitHub login. hosts.yml holds the token in plaintext; the host directory must exist.
		"source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
		// Keep the crates.io download cache in a named volume, shared by every Rust devcontainer,
		// so rebuilding a container doesn't re-download every dependency.
		"source=devcontainer-cargo-registry,target=/usr/local/cargo/registry,type=volume"
	],

	// Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
	"remoteUser": "vscode"
}
