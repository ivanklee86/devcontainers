{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "groupName": "docker base images",
      "groupSlug": "docker-base-images",
      "matchManagers": ["dockerfile", "devcontainer"]
    },
    {
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "pinned tool versions",
      "groupSlug": "pinned-tool-versions",
      "matchManagers": ["regex"]
    }
  ],
  "customManagers": [
    {
      "description": "GitHub release download URLs in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Taskfile install script version flag in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "taskfile\\.dev/install\\.sh.*-- -d (?<currentValue>v[^\\s\"']+)"
      ],
      "depNameTemplate": "go-task/task",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "go install commands in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "go install (?<depName>[^@]+)@(?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "description": "Pinned ARG versions with renovate annotations in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\w+=(?<currentValue>\\S+)"
      ]
    }
  ]
}
